{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aschepis/maslow/schema/evidence.schema.json",
  "title": "Maslow evidence",
  "description": "The evidence file written by maslow verify and maslow audit. Format version 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_version",
    "maslow_version",
    "command",
    "timestamp",
    "spec_path",
    "spec_sha256",
    "spec_source",
    "profile",
    "verdict",
    "check_results"
  ],
  "properties": {
    "evidence_version": { "const": "2" },
    "maslow_version": { "type": "string", "minLength": 1 },
    "command": { "enum": ["verify", "audit"] },
    "timestamp": { "type": "string", "minLength": 1 },
    "spec_path": { "type": "string" },
    "spec_sha256": { "type": "string" },
    "spec_source": { "enum": ["head", "base"] },
    "git_sha": { "type": "string" },
    "base_sha": { "type": "string" },
    "profile": { "type": "string" },
    "verdict": { "enum": ["pass", "fail", "needs_review", "inconclusive"] },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "check_results": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/check" }
    },
    "contracts": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
    "budgets": { "type": "array", "items": { "$ref": "#/$defs/budget" } },
    "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
    "policy": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "coverage": {
      "type": "array",
      "description": "derived from each check's and contract's covers, sorted by id; maslow evidence check recomputes it and ignores this field",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "results"],
        "properties": {
          "id": { "$ref": "#/$defs/requirementId" },
          "status": { "enum": ["pass", "fail", "needs_review", "skip"] },
          "results": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(check|contract):" },
            "description": "the covering results, as check:<name> or contract:<name>"
          }
        }
      }
    }
  },
  "$defs": {
    "requirementId": { "type": "string", "pattern": "^\\S+$", "description": "an opaque requirement reference with no whitespace, compared exactly (ADR 0043)" },
    "covers": { "type": "array", "items": { "$ref": "#/$defs/requirementId" }, "description": "requirement IDs this result covers; never affects the verdict" },
    "status": { "enum": ["pass", "fail", "skip", "error"] },
    "resultStatus": { "enum": ["pass", "fail", "skip", "error", "flaky"], "description": "a check or contract result; flaky means it failed and then passed on a retry" },
    "policyStatus": { "enum": ["pass", "fail", "skip", "error", "needs_review", "would_fail", "would_need_review", "would_error"] },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "status", "duration_seconds"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "status": { "$ref": "#/$defs/resultStatus" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "output": { "type": "string" },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "output_truncated": { "type": "boolean" },
        "error": { "type": "string" },
        "attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkAttempt" },
          "description": "set only when the check ran more than once; the other fields describe the last attempt, and duration_seconds is the total"
        },
        "covers": { "$ref": "#/$defs/covers" },
        "inherited_env": { "type": "boolean", "description": "true when the spec's checks.inherit_env, or a binary audit target's inherit_env, gave the check Maslow's whole environment instead of the scrubbed one (ADRs 0046 and 0048)" }
      }
    },
    "checkAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "duration_seconds"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "output": { "type": "string" },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "output_truncated": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["pass", "fail", "skip", "error", "not_red", "flaky"] },
        "error": { "type": "string" },
        "overlay": { "type": "string" },
        "failed_step": { "$ref": "#/$defs/failedStep" },
        "output": { "type": "string" },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "output_truncated": { "type": "boolean" },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "head_status": { "$ref": "#/$defs/resultStatus", "description": "red-green runs only: the contract's own result on the head" },
        "base": { "$ref": "#/$defs/baseRun" },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
        "attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/contractAttempt" },
          "description": "set only when the scenario ran more than once; the other fields describe the last attempt"
        },
        "covers": { "$ref": "#/$defs/covers", "description": "the contract's and the scenario's requirement IDs, sorted and deduplicated" },
        "inherited_env": { "type": "boolean", "description": "true when the contract's inherit_env gave its CLI steps Maslow's whole environment instead of the scrubbed one (ADR 0048)" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "description": "what one metric, log or alerts step asked its provider and saw",
      "required": ["phase", "index", "action", "provider", "url", "expect", "samples"],
      "properties": {
        "phase": { "enum": ["setup", "steps"] },
        "index": { "type": "integer", "minimum": 0 },
        "action": { "enum": ["metric", "log", "alerts"] },
        "provider": { "type": "string" },
        "url": { "type": "string", "description": "as written in the spec, before templating" },
        "query": { "type": "string" },
        "matchers": { "type": "array", "items": { "type": "string" } },
        "ignore_preexisting": { "type": "boolean" },
        "for": { "type": "string" },
        "interval": { "type": "string" },
        "settle": { "type": "string" },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "min_series": { "type": "integer", "minimum": 0 },
            "max_series": { "type": "integer", "minimum": 0 },
            "if_no_data": { "enum": ["fail", "pass"] }
          }
        },
        "samples": { "type": "array", "items": { "$ref": "#/$defs/sample" } },
        "breach": { "type": "string" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "description": "one query at one evaluation time; min and max are strings so +Inf and NaN survive JSON",
      "required": ["at", "ok"],
      "properties": {
        "at": { "type": "string" },
        "series": { "type": "integer", "minimum": 0 },
        "alerts": { "type": "integer", "minimum": 0 },
        "min": { "type": "string" },
        "max": { "type": "string" },
        "no_data": { "type": "boolean" },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "contractAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "error": { "type": "string" },
        "failed_step": { "$ref": "#/$defs/failedStep" },
        "output": { "type": "string" },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "output_truncated": { "type": "boolean" },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
      }
    },
    "baseRun": {
      "type": "object",
      "additionalProperties": false,
      "description": "red-green runs only: the same contract run against the base commit",
      "required": ["sha", "status"],
      "properties": {
        "sha": { "type": "string" },
        "status": { "$ref": "#/$defs/resultStatus" },
        "error": { "type": "string" },
        "failed_step": { "$ref": "#/$defs/failedStep" },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/contractAttempt" } }
      }
    },
    "failedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "index", "action"],
      "properties": {
        "phase": { "enum": ["contract_setup", "setup", "steps"] },
        "index": { "type": "integer", "minimum": 0 },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "page_url": { "type": "string" },
        "console": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "status"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "actual": { "type": "string" },
        "limit": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "status"],
      "properties": {
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "error": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "kind", "status"],
      "properties": {
        "rule": { "type": "string" },
        "kind": { "enum": ["deny", "protected", "gated", "allow", "spec", "shrink_only", "test_integrity"] },
        "mode": { "enum": ["observe"] },
        "status": { "$ref": "#/$defs/policyStatus" },
        "detail": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "lines": { "type": "array", "items": { "type": "string" }, "description": "path:line: text entries flagged by a line-level rule" },
        "owner": { "type": "string" },
        "error": { "type": "string" }
      }
    }
  }
}
